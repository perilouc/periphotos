---
layout: base.njk
title: Journal
section: journal
permalink: /journal/
---
<section class="wrap intro">
  <div class="intro-title">
    <span class="eyebrow">Notes from the road</span>
    <h1>Journal</h1>
  </div>
</section>
<section class="wrap block">
  {% for post in collections.journal %}
  <a class="entry" href="{{ post.url }}">
    <span class="muted">{{ post.date | monthYear }}{% if post.data.place %} · {{ post.data.place }}{% endif %}</span>
    <span class="entry-title">{{ post.data.title }}</span>
  </a>
  {% endfor %}
</section>
